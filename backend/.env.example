# Configuración de PostgreSQL para Active Gym.
# Reemplazar los valores de ejemplo en el archivo .env local.
# Si la contraseña contiene caracteres especiales,
# deben codificarse correctamente dentro de la URL.

DATABASE_URL=postgresql+psycopg://active_gym_user:REEMPLAZAR_CONTRASENA@127.0.0.1:5432/active_gym_db